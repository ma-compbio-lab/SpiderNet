    "    adata_i = processed.adata_list[i]\n",
    "    edge_index_max = torch.max(processed.spidernet_data[i][\"edge_index\"]).cpu().item()\n",
    "    summary_rows.append(\n",
    "        {\n",
    "            \"batch_index\": i,\n",
    "            \"n_cells\": adata_i.n_obs,\n",
    "            \"n_genes\": adata_i.n_vars,\n",
    "            \"edge_index_max\": edge_index_max,\n",
