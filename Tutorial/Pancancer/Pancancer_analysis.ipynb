    "    metadata_sample = metadata_sample.merge(celltype_counts, on=SAMPLE_COL, how=\"left\")\n",
    "    metadata_sample = metadata_sample.sort_values(\n",
    "        [\"source_file_prefix\", \"subslice_id\", SAMPLE_COL]\n",
    "    ).reset_index(drop=True)\n",
    "\n",
