    "    # Select only sampled edges from current batch\n",
    "    # Support both E x 2 and 2 x E layouts.\n",
    "    # --------------------------------------------------\n",
    "    if torch.is_tensor(edge_index_cur):\n",
    "        local_edge_idx_t = torch.as_tensor(\n",
