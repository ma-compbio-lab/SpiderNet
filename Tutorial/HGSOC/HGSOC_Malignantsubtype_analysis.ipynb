    "# Step 3. Collect all KEGG terms across clusters\n",
    "# ==============================================================\n",
    "\n",
    "all_kegg_terms = sorted({term for df in kegg_results.values() if 'Term' in df.columns for term in df['Term']})\n",
    "print(f\"Total unique KEGG terms: {len(all_kegg_terms)}\")\n"
