   "source": [
    "## 6. In silico perturbation analysis of a selected MI-linked signaling program\n",
    "\n",
    "This section extends the malignant-subtype analysis by using the trained **SpiderNet** model to perform **in silico perturbation** of a selected **Fibroblast → malignant** signaling program.\n",
    "The goal is to test how perturbing the top **ligand–receptor (LR) genes** associated with a chosen **meta-interaction (MI)** reshapes predicted **CAF programs** in fibroblasts and **functional-state programs** in the target malignant subtype.\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d1de7561783cf6b7",
   "metadata": {},
   "source": [
    "### Load the trained model and supporting files\n"
   ]
  },
  {
   "cell_type": "code",
   "id": "91f16b2e4e81178e",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-04-22T22:27:36.669292Z",
     "start_time": "2026-04-22T22:27:36.444517Z"
    }
   },
   "source": [
    "from pathlib import Path\n",
    "import json\n",
    "import re\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "\n",
    "adata_list = processed.adata_list\n",
    "SpiderNet_data_pyg_list = processed.spidernet_data\n",
    "\n",
    "run_dir = Path(run_dirs[\"run_dir\"])\n",
    "model_dir = run_dir / \"Model\"\n",
    "\n",
    "Factor_envir_list = pd.read_pickle(run_dir / \"Factor_envir_list.pkl\")\n",
    "loading_LR_use_df = pd.read_csv(run_dir / \"loading_LR_use.csv\", index_col=0)\n",
    "LR_list = processed.lr_list\n",
    "\n",
    "model_config_path = model_dir / \"SpiderNet_model_config.json\"\n",
    "with open(model_config_path, \"r\", encoding=\"utf-8\") as f:\n",
    "    model_config_dict = json.load(f)\n",
    "train_cfg = TrainingConfig(**model_config_dict)\n",
    "\n",
    "from SpiderNet.api import build_model\n",
    "model = build_model(\n",
    "    processed=processed,\n",
    "    train_cfg=train_cfg,\n",
    "    device=device,\n",
    ")\n",
    "\n",
    "# Prefer the final epoch checkpoint if available; otherwise use the latest one found\n",
    "model_ckpt_candidates = sorted(\n",
    "    model_dir.glob(\"model_epoch*.pth\"),\n",
    "    key=lambda p: int(re.search(r\"model_epoch(\\d+)\\.pth$\", p.name).group(1))\n",
    ")\n",
    "if len(model_ckpt_candidates) == 0:\n",
    "    raise FileNotFoundError(f\"No model checkpoint found in: {model_dir}\")\n",
    "\n",
    "preferred_ckpt = model_dir / \"model_epoch19999.pth\"\n",
    "model_ckpt_path = preferred_ckpt if preferred_ckpt.exists() else model_ckpt_candidates[-1]\n",
    "\n",
    "model.load_state_dict(torch.load(model_ckpt_path, map_location=device))\n",
    "model = model.to(device)\n",
    "model.eval()\n",
    "\n",
    "print(f\"Loaded model config from: {model_config_path}\")\n",
    "print(f\"Loaded checkpoint from: {model_ckpt_path.name}\")\n"
   ],
