    "    Factor_envir_cur_Tcellonly_receiver_agg_nonan_MI29_choose = Factor_envir_cur_Tcellonly_receiver_agg_nonan_MI29[cellindex_Factor_envir_cur_Tcellonly_receiver_agg_nonan_MI29_nonzero]\n",
    "    exp_nor_all_aginggenes_norm_mean_cur_choose = exp_nor_all_aginggenes_norm_mean_cur[cellindex_Factor_envir_cur_Tcellonly_receiver_agg_nonan_MI29_nonzero]\n",
