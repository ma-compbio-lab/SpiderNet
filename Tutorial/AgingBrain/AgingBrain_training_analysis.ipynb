  {
   "cell_type": "code",
   "id": "547dc830122273ca",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-04-23T02:42:02.069147Z",
     "start_time": "2026-04-23T02:41:51.152996Z"
