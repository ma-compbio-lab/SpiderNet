   "source": [
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "plt.rcParams['pdf.fonttype'] = 42\n",
    "plt.rcParams['mathtext.fontset'] = 'dejavuserif'\n",
    "plt.rcParams['font.family'] = 'arial'\n",
    "\n",
    "df = pearson_corr_dict_df.copy()\n",
    "\n",
    "required_cols = [\"SpiderNet\", \"PCA\", \"Banksy\", \"COMMOT\"]\n",
    "missing = [c for c in required_cols if c not in df.columns]\n",
    "if len(missing) > 0:\n",
    "    raise ValueError(f\"pearson_corr_dict_df missing columns: {missing}\")\n",
    "\n",
    "# ====== 1. Compute the improvement ratio for each cell type ======\n",
    "safe_div = lambda a, b: a / np.where(b == 0, np.nan, b)\n",
    "\n",
    "improve_vs_pca    = safe_div(df[\"SpiderNet\"], df[\"PCA\"])\n",
    "improve_vs_banksy = safe_div(df[\"SpiderNet\"], df[\"Banksy\"])\n",
    "improve_vs_commot = safe_div(df[\"SpiderNet\"], df[\"COMMOT\"])\n",
    "\n",
    "# Minimum improvement ratio of SpiderNet relative to the baselines\n",
    "df[\"ImproveRatio\"] = np.nanmin(\n",
    "    np.vstack([improve_vs_pca, improve_vs_banksy, improve_vs_commot]),\n",
    "    axis=0\n",
    ")\n",
    "\n",
    "df[\"ImproveRatio\"].replace([np.inf, -np.inf], np.nan, inplace=True)\n",
    "df[\"ImproveRatio\"].fillna(0, inplace=True)\n",
    "\n",
    "# ====== 2. Sort cell types ======\n",
    "df_sorted = df.sort_values(by=\"ImproveRatio\", ascending=False)\n",
    "\n",
    "# ====== 3. Convert to long format ======\n",
    "df_long = df_sorted.reset_index().melt(\n",
    "    id_vars='index',\n",
    "    value_vars=['SpiderNet', 'PCA', 'Banksy', 'COMMOT'],\n",
    "    var_name='Method',\n",
    "    value_name='Pearson_r'\n",
    ")\n",
    "df_long.rename(columns={'index': 'CellType'}, inplace=True)\n",
    "\n",
    "# ====== 4. Horizontal bar plot with grouped spacing and reversed display order ======\n",
    "plt.figure(figsize=(5.45 * 0.9, 4.48 * 0.9), facecolor='white')\n",
    "ax = plt.gca()\n",
    "ax.set_facecolor(\"white\")\n",
    "\n",
    "# Display order of methods (edit this if you want a different plotting order)\n",
    "methods = ['COMMOT', 'Banksy', 'PCA', 'SpiderNet']\n",
    "\n",
    "colors = {\n",
    "    'SpiderNet': \"#D25353\",\n",
    "    'PCA': \"#3d79ac\",\n",
    "    'Banksy': \"#6CA651\",\n",
    "    'COMMOT': \"#D98C3A\",   # Custom color for COMMOT\n",
    "}\n",
    "\n",
    "# Reverse the cell-type order for plotting\n",
    "celltypes = df_sorted.reset_index()['index'].tolist()[::-1]\n",
    "\n",
    "mat = (\n",
    "    df_sorted.reset_index()\n",
    "    .set_index('index')[methods]\n",
    "    .reindex(celltypes)\n",
    ")\n",
    "\n",
    "y = np.arange(len(celltypes))\n",
    "\n",
    "n_hue = len(methods)\n",
    "group_height = 0.82\n",
    "inner_gap = 0.06\n",
    "\n",
    "bar_h = (group_height - inner_gap * (n_hue - 1)) / n_hue\n",
    "offsets = (-group_height/2) + (np.arange(n_hue) + 0.5) * bar_h + np.arange(n_hue) * inner_gap\n",
    "\n",
    "for j, m in enumerate(methods):\n",
    "    ax.barh(\n",
    "        y + offsets[j],\n",
    "        mat[m].values,\n",
    "        height=bar_h,\n",
    "        color=colors[m],\n",
    "        edgecolor='none',\n",
    "        label=m\n",
    "    )\n",
    "\n",
    "ax.set_yticks(y)\n",
    "ax.set_yticklabels(celltypes)\n",
    "\n",
    "sns.despine(ax=ax, top=True, right=True)\n",
    "ax.spines['left'].set_visible(True)\n",
    "ax.spines['bottom'].set_visible(True)\n",
    "ax.spines['left'].set_color(\"black\")\n",
    "ax.spines['bottom'].set_color(\"black\")\n",
    "ax.spines['left'].set_linewidth(1.0)\n",
    "ax.spines['bottom'].set_linewidth(1.0)\n",
    "\n",
    "# ax.set_xlim(left=0.3)\n",
    "# ax.set_xticks([0.3, 0.4, 0.5, 0.6])\n",
    "ax.set_xlim(left=0)\n",
    "# ax.set_xticklabels([\"0.3\", \"0.4\", \"0.5\", \"0.6\"])\n",
    "\n",
    "ax.set_ylabel('Cell type')\n",
    "ax.set_xlabel('Pearson correlation')\n",
    "\n",
    "ax.legend(title='Method', bbox_to_anchor=(1.02, 1), loc='upper left', frameon=False)\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig(str(run_dirs['run_dir']) + '/Celltype_age_prediction_pearsonr_comparison.pdf', dpi=300)\n",
    "plt.show()\n",
    "plt.close()\n"
   ],
