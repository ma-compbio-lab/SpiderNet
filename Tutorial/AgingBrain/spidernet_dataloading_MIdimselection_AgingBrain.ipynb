      "  from pkg_resources import get_distribution, DistributionNotFound\n"
     ]
    }
   ],
   "execution_count": 1
  },
  {
   "cell_type": "markdown",
   "id": "49e0bf78",
   "metadata": {},
   "source": [
    "## Step 1. Basic user inputs\n",
    "\n",
    "Edit the variables in this section first.\n"
   ]
  },
  {
   "cell_type": "code",
   "id": "b2448239",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-04-23T02:23:40.707401Z",
     "start_time": "2026-04-23T02:23:40.703193Z"
    }
   },
   "source": [
    "DATA_ROOT = Path(\"D:/SpiderNet/Data/AgingBrain\")  ## Set this to your local AgingBrain data directory\n",
    "OUTPUT_DIR = Path(\"D:/SpiderNet/Results/AgingBrain/ProcessedData\")  ## Set this to your desired processed-data directory\n",
    "\n",
    "SPECIES = \"mouse\"  ## Species used for ligand-receptor database loading. Options are \"human\" or \"mouse\".\n",
    "\n",
    "SAMPLE_COL = \"age\"  ## The sample-defining column in adata.obs. For AgingBrain, each age is treated as one sample/batch.\n",
    "CELL_CLASS_COL = \"celltype\"  ## The cell type annotation column in adata.obs.\n",
    "PYG_EXTRA_OBS_FIELDS = {\n",
    "    \"age\": \"age\",\n",
    "    \"batch\": \"age\",\n",
    "    \"region\": \"region\",\n",
    "    \"subregion\": \"subregion\",\n",
    "}  ## Extra adata.obs fields to copy into each PyG sample object.\n",
    "\n",
    "N_HVG = 1000  ## Number of top highly variable genes used as SpiderNet model input for training\n",
    "N_HVG_LR = 2000  ## Number of top highly variable genes used to define the candidate ligand-receptor search space; LR pairs are selected only if their genes are within these top genes\n",
    "NUM_NEIGHBORS = 5  ## Number of spatial neighbors\n",
    "\n",
    "# Set this only after running the preview section below\n",
    "LR_CORR_THRESHOLD = None  ## Set this to the desired ligand-receptor correlation threshold after inspecting the preview plot in Step 4. In the original AgingBrain script, the default filtering logic corresponded to using 0.3 here.\n"
   ],
   "outputs": [],
   "execution_count": 2
  },
  {
   "cell_type": "markdown",
   "id": "e7d7fd57",
   "metadata": {},
   "source": [
    "## Step 2. AgingBrain-specific SpiderNet input\n",
    "\n",
    "This notebook follows the AgingBrain data convention used in the original\n",
    "`dataloading_AgingBrain` script:\n",
    "\n",
    "- raw counts are stored in `X`\n",
    "- spatial coordinates are stored in `obs[['center_x', 'center_y']]`\n",
    "- samples are defined by `obs['age']`\n",
    "- AnnData files are sorted by the numeric age encoded in filenames like `*_ageXX.h5ad`\n",
    "\n",
    "Because this convention is specific to the AgingBrain data, these settings are\n",
    "kept out of the main user-input block above.\n"
   ]
  },
  {
   "cell_type": "code",
   "id": "3efb50b4",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-04-23T02:23:40.711890Z",
     "start_time": "2026-04-23T02:23:40.707401Z"
    }
   },
   "source": [
    "CELLCHAT_DB = get_default_cellchat_db(species=SPECIES)\n",
    "SCSEQCOMM_DB = get_default_scseqcomm_db(species=SPECIES)\n",
    "\n",
    "def extract_age_from_filename(file_name: str) -> float:\n",
    "    stem = Path(file_name).stem\n",
    "    if \"_age\" not in stem:\n",
    "        raise ValueError(\n",
    "            f\"Cannot parse age from file name: {file_name}. Expected a pattern like '*_age12.h5ad'.\"\n",
    "        )\n",
    "    return float(stem.split(\"_age\", 1)[1])\n",
    "\n",
    "DATA_REPRESENTATION_CONFIG = {\n",
    "    \"expression_source\": {\"kind\": \"X\", \"name\": None},\n",
    "    \"normalize_strategy\": \"always\",\n",
    "    \"log1p\": True,\n",
    "    \"remove_zero_count_cells\": False,\n",
    "    \"spatial_source\": {\"kind\": \"obs\", \"cols\": [\"center_x\", \"center_y\"]},\n",
    "    \"file_sort_key\": extract_age_from_filename,\n",
    "    \"sample_sort\": \"auto\",\n",
    "}\n"
   ],
   "outputs": [],
   "execution_count": 3
  },
  {
   "cell_type": "markdown",
   "id": "eb800202",
   "metadata": {},
   "source": [
    "## Step 3. Build the base config\n",
    "\n",
    "This config contains the common loading settings for the AgingBrain dataset.\n",
    "`lr_corr_threshold` is intentionally left unset until after the preview step.\n"
   ]
  },
  {
   "cell_type": "code",
   "id": "d218b3b1",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-04-23T02:23:40.723170Z",
     "start_time": "2026-04-23T02:23:40.712895Z"
    }
   },
   "source": [
