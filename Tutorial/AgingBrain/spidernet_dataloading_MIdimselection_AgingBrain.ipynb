    "    \"normalize_strategy\": base_config[\"normalize_strategy\"],\n",
    "    \"spatial_source\": str(base_config[\"spatial_source\"]),\n",
    "    \"file_sort_key\": getattr(base_config[\"file_sort_key\"], \"__name__\", str(base_config[\"file_sort_key\"])),\n",
    "}).to_frame(\"value\")\n"
